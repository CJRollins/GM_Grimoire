  "contentHtml": "<div class=\"article-main\">\n                <div class=\"header_one\">\n<div class=\"header_two\">\n<div class=\"header_three\">\n<h1 class=\"source\">Eberron: Forge of the Artificer</h1>\n</div>\n</div>\n</div>\n<blockquote class=\"compendium-toc-blockquote\"><p class=\"compendium-intro-text\">Step into the world of innovation, intrigue, and arcane technology like never before.</p><a class=\"view-cover-art display-as-button ddb-lightbox-outer compendium-image-center\" href=\"https://media.dndbeyond.com/compendium-images/efota/Jae5SyNcfFGjapTb/efota-cover.jpg\" data-lightbox=\"1\" data-title=\"\">View Cover Art</a></blockquote>\n<div class=\"compendium-toc-full\">\n<div class=\"compendium-toc-full-header\">\n<h2 id=\"Contents\">Contents</h2>\n</div>\n<div class=\"compendium-toc-full-text\">\n<h3><a href=\"/chapters/introduction/\">Introduction: Forge of the Artificer</a></h3><ul><li><a href=\"/chapters/introduction/#ABoxOfNewTools\">A Box of New Tools</a></li>\n<li><a href=\"/chapters/introduction/#TheDraconicProphecy\">The Draconic Prophecy</a></li>\n</ul><h3><a href=\"/chapters/the-artificer/\">Chapter 1: The Artificer</a></h3><ul><li><a href=\"/chapters/the-artificer/#CoreArtificerTraits\">Core Artificer Traits</a></li>\n<li><a href=\"/chapters/the-artificer/#BecomingAnArtificer\">Becoming an Artificer...</a></li>\n<li><a href=\"/chapters/the-artificer/#ArtificerClassFeatures\">Artificer Class Features</a></li>\n<li><a href=\"/chapters/the-artificer/#ArtificerSubclasses\">Artificer Subclasses</a></li>\n<li class=\"toc--indented\"><a href=\"/chapters/the-artificer/#Alchemist\">Alchemist</a></li>\n<li class=\"toc--indented\"><a href=\"/chapters/the-artificer/#Armorer\">Armorer</a></li>\n<li class=\"toc--indented\"><a href=\"/chapters/the-artificer/#Artillerist\">Artillerist</a></li>\n<li class=\"toc--indented\"><a href=\"/chapters/the-artificer/#BattleSmith\">Battle Smith</a></li>\n<li class=\"toc--indented\"><a href=\"/chapters/the-artificer/#C